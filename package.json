{
  "name": "flight-radar",
  "author": "SoulReaver-SS",
  "version": "0.5.1",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "pebble": {
    "displayName": "Flight Radar",
    "uuid": "a8c039ca-8cc9-4856-91fd-371ebaa9719c",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "CMD",
      "STATUS",
      "SRC",
      "USER_X",
      "USER_Y",
      "MPP10",
      "PLANES",
      "PLANE_COUNT",
      "MAP_ID",
      "MAP_TOTAL",
      "MAP_OFFSET",
      "MAP_CHUNK",
      "ROAD_STYLE",
      "SHOW_RING",
      "INTERVAL_MIN",
      "RADIUS_NM",
      "CFG_WB_KEY",
      "CFG_PM_KEY",
      "CFG_INTERVAL",
      "CFG_RADIUS",
      "CFG_ROADS",
      "CFG_RING",
      "CFG_GROUND",
      "LOC_LABEL",
      "TOUCH_ZOOM",
      "CFG_LOC_MODE",
      "CFG_PRESET",
      "CFG_ZIP",
      "CFG_COORDS",
      "CFG_TOUCH_ZOOM",
      "UNIT",
      "LIVE_SECS",
      "NIGHT_FROM",
      "NIGHT_TO",
      "LABELS",
      "BATTERY",
      "TRAIL_MODE",
      "TRAILS",
      "ROUTE",
      "NEAR_CS",
      "NEAR_TYPE",
      "ALERT",
      "ALERT_KIND",
      "CFG_LIVE",
      "CFG_NIGHT",
      "CFG_NIGHT_FROM",
      "CFG_NIGHT_TO",
      "CFG_TRAILS",
      "CFG_LABELS",
      "CFG_BATTERY",
      "CFG_RECEIVER",
      "CFG_ALERT_SQUAWK",
      "CFG_ALERT_LOW",
      "CFG_ALERT_LOW_FT",
      "CFG_ALERT_MIL",
      "CFG_ALERT_HELI",
      "CFG_WATCHLIST",
      "SHOW_HR",
      "SHOW_STEPS",
      "CFG_HR",
      "CFG_STEPS",
      "RANGE_LABEL",
      "CFG_RANGE_LABEL"
    ],
    "resources": {
      "media": [
        {
          "type": "font",
          "name": "FONT_TIME_30",
          "file": "fonts/IBMPlexMono-SemiBold.ttf",
          "characterRegex": "[0-9:_]"
        },
        {
          "type": "font",
          "name": "FONT_TIME_22",
          "file": "fonts/IBMPlexMono-SemiBold.ttf",
          "characterRegex": "[0-9:]"
        },
        {
          "type": "font",
          "name": "FONT_SMALL_14",
          "file": "fonts/IBMPlexMono-Medium.ttf",
          "characterRegex": "[ -~]"
        },
        {
          "type": "font",
          "name": "FONT_TINY_11",
          "file": "fonts/IBMPlexMono-Medium.ttf",
          "characterRegex": "[ -~]"
        }
      ]
    },
    "capabilities": [
      "location",
      "configurable",
      "health"
    ],
    "usesPermissions": [
      "Location",
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "api.adsb.lol",
            "api.protomaps.com",
            "customer-api.wingbits.com",
            "api.zippopotam.us",
            "tiles.openfreemap.org",
            "opendata.adsb.fi",
            "api.adsbdb.com"
          ]
        }
      },
      {
        "name": "LocalNetwork"
      }
    ]
  },
  "dependencies": {
    "@rebble/clay": "^1.1.0"
  }
}
